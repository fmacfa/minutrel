# Docker Compose lit .env. En lancement Node, exporter ces variables dans le shell.
# Premier compte : secret généré dans data/setup-token (pas de mot de passe par défaut).
APP_PUBLIC_URL=http://127.0.0.1:8080
APP_SECURE_COOKIES=false
MINUTREL_BIND_ADDR=127.0.0.1
MINUTREL_PORT=8080
# Hôtes exacts autorisés pour les moteurs de comptes rendus.
APP_AI_ALLOWED_HOSTS=localhost,127.0.0.1,ollama,vllm,api.anthropic.com
# Lancement Node (sans Docker) :
# APP_HOST=127.0.0.1
# APP_PORT=8081
# APP_DATA_DIR=./data
# APP_WEB_DIR=./apps/web/dist
# Secret d’installation et clé de chiffrement générés automatiquement et persistés.
# APP_SETUP_TOKEN=<secret long aléatoire, à usage unique>
# APP_MASTER_KEY=<32 octets aléatoires en base64url, à conserver pour restaurer>
